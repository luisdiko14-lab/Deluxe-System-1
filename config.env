# Deluxe System 1 — build configuration (sourced by build.sh and by every chroot hook)
# Override any value from the environment, e.g.:  SQUASHFS_COMP=zstd sudo -E ./build.sh

DELUXE_NAME="Deluxe System 1"
DELUXE_VERSION="1.0"
DELUXE_CODENAME="Aurora"
DELUXE_ID="deluxe"
DELUXE_ISO_BASENAME="deluxe-system-1"
DELUXE_VOLID="DELUXE_SYSTEM_1_0"        # ISO9660 volume label, max 32 chars
DELUXE_URL="https://example.org/deluxe-system-1"   # <- put your real project URL here

UBUNTU_SUITE="noble"                    # Ubuntu 24.04 LTS
UBUNTU_MIRROR="${UBUNTU_MIRROR:-http://archive.ubuntu.com/ubuntu}"

# Reproducibility: pin the archive to a point in time using Ubuntu's snapshot service.
# Example: DELUXE_SNAPSHOT=20261101T000000Z   (empty = use the live archive, newest packages)
DELUXE_SNAPSHOT="${DELUXE_SNAPSHOT:-}"

# Optional: pin the VSCodium signing key by fingerprint (build prints the fingerprint it saw).
VSCODIUM_KEY_FPR="${VSCODIUM_KEY_FPR:-}"
# Mozilla's published APT signing key fingerprint (verified at build time).
MOZILLA_KEY_FPR="35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3"

LIVE_USER="deluxe"                      # passwordless live-session account
SQUASHFS_COMP="${SQUASHFS_COMP:-xz}"    # xz = smallest ISO, zstd = much faster builds
MAX_ISO_BYTES=4700000000                # build fails if the ISO is larger than this
MIN_FREE_GB=30                          # free disk space required in the work directory
APT_PROXY="${APT_PROXY:-}"              # e.g. http://localhost:3142 (apt-cacher-ng) to speed up rebuilds
