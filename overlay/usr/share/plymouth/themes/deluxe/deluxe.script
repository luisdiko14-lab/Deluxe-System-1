# Deluxe System 1 Plymouth script: navy gradient, centred logo, slim gold progress bar, password prompt.

Window.SetBackgroundTopColor(0.055, 0.090, 0.220);
Window.SetBackgroundBottomColor(0.027, 0.047, 0.125);

sw = Window.GetWidth();
sh = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(sh / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetOpacity(1);

bar_bg.image = Image("bar-bg.png");
bar_bg.sprite = Sprite(bar_bg.image);
bar_bg.x = sw / 2 - bar_bg.image.GetWidth() / 2;
bar_bg.y = sh / 2 + logo.image.GetHeight() / 2 + 20;
bar_bg.sprite.SetPosition(bar_bg.x, bar_bg.y, 1);

bar_fg.original = Image("bar-fg.png");
bar_fg.sprite = Sprite();
bar_fg.sprite.SetPosition(bar_bg.x, bar_bg.y, 2);

fun progress_callback(duration, progress) {
  w = Math.Int(bar_fg.original.GetWidth() * progress);
  if (w < 1) w = 1;
  bar_fg.sprite.SetImage(bar_fg.original.Scale(w, bar_fg.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Slow pulse of the logo while booting
pulse_tick = 0;
fun refresh_callback() {
  pulse_tick++;
  logo.sprite.SetOpacity(0.82 + 0.18 * Math.Cos(pulse_tick / 18.0));
}
Plymouth.SetRefreshFunction(refresh_callback);

# Disk-encryption passphrase prompt (shown for installs that used the LUKS option)
box.image = Image("box.png");
box.sprite = Sprite(box.image);
box.sprite.SetPosition(sw / 2 - box.image.GetWidth() / 2, sh * 0.72, 10);
box.sprite.SetOpacity(0);
bullet.image = Image("bullet.png");
bullets = [];
prompt.sprite = Sprite();

fun password_callback(prompt_text, bullet_count) {
  box.sprite.SetOpacity(1);
  p = Image.Text(prompt_text, 1, 1, 1);
  prompt.sprite.SetImage(p);
  prompt.sprite.SetPosition(sw / 2 - p.GetWidth() / 2, sh * 0.72 - 34, 11);
  for (i = 0; i < bullet_count; i++) {
    bullets[i].sprite = Sprite(bullet.image);
    bullets[i].sprite.SetPosition(sw / 2 - box.image.GetWidth() / 2 + 16 + i * 20, sh * 0.72 + 12, 12);
  }
  for (j = bullet_count; j < 40; j++) bullets[j].sprite = NULL;
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  box.sprite.SetOpacity(0);
  prompt.sprite.SetOpacity(0);
  for (i = 0; i < 40; i++) bullets[i].sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(normal_callback);

message.sprite = Sprite();
fun message_callback(text) {
  m = Image.Text(text, 0.9, 0.9, 0.95);
  message.sprite.SetImage(m);
  message.sprite.SetPosition(sw / 2 - m.GetWidth() / 2, sh - 60, 5);
}
Plymouth.SetMessageFunction(message_callback);
