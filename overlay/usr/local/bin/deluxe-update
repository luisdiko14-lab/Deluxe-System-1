#!/usr/bin/env bash
# deluxe-update — update APT packages, Flatpak apps and device firmware in one go.
#
#   deluxe-update            update everything
#   deluxe-update --check    only report what is pending (no changes)
#   deluxe-update --no-firmware | --no-flatpak | --no-apt   skip a part
#   deluxe-update --pause    wait for Enter at the end (used by the desktop shortcut)
set -u

DO_APT=1 DO_FLATPAK=1 DO_FW=1 CHECK=0 PAUSE=0
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    --no-apt) DO_APT=0 ;;
    --no-flatpak) DO_FLATPAK=0 ;;
    --no-firmware) DO_FW=0 ;;
    --pause) PAUSE=1 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "unknown option: $a (try --help)" >&2; exit 2 ;;
  esac
done

b() { printf '\n\033[1;33m==> %s\033[0m\n' "$*"; }
FAILED=()
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 || { echo "sudo is required" >&2; exit 1; }
  SUDO="sudo"
fi
done_msg() {
  echo
  if [ "${#FAILED[@]}" -eq 0 ]; then echo "All done. ✔"; else echo "Finished with problems in: ${FAILED[*]}"; fi
  [ -f /var/run/reboot-required ] && echo "A restart is needed to finish some updates."
  [ "$PAUSE" = 1 ] && read -r -p "Press Enter to close…" _
  [ "${#FAILED[@]}" -eq 0 ]
}

if [ "$CHECK" = 1 ]; then
  if [ "$DO_APT" = 1 ]; then
    b "APT"; apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | grep -c '^Inst ' | sed 's/^/upgradable packages: /'
  fi
  if [ "$DO_FLATPAK" = 1 ] && command -v flatpak >/dev/null; then
    b "Flatpak"; flatpak remote-ls --updates 2>/dev/null | wc -l | sed 's/^/updatable apps/runtimes: /'
  fi
  if [ "$DO_FW" = 1 ] && command -v fwupdmgr >/dev/null; then
    b "Firmware"; fwupdmgr get-updates --no-unreported-check 2>/dev/null | grep -E 'Update|Version' | head -n 10 || echo "no firmware updates"
  fi
  exit 0
fi

if [ "$DO_APT" = 1 ]; then
  b "System packages (APT)"
  $SUDO apt-get update \
    && $SUDO apt-get -y full-upgrade \
    && $SUDO apt-get -y autoremove --purge \
    && $SUDO apt-get -y autoclean || FAILED+=("apt")
fi

if [ "$DO_FLATPAK" = 1 ] && command -v flatpak >/dev/null; then
  b "Flatpak apps"
  $SUDO flatpak update --system -y --noninteractive || FAILED+=("flatpak")
  flatpak update --user -y --noninteractive 2>/dev/null || true
  $SUDO flatpak uninstall --unused -y --noninteractive 2>/dev/null || true
fi

if [ "$DO_FW" = 1 ] && command -v fwupdmgr >/dev/null; then
  b "Firmware (fwupd / LVFS)"
  $SUDO fwupdmgr refresh --force >/dev/null 2>&1 || echo "could not refresh firmware metadata (offline?)"
  # exit code 2 = "nothing to do" — not an error
  $SUDO fwupdmgr get-updates --no-unreported-check -y >/dev/null 2>&1
  case $? in
    0) $SUDO fwupdmgr update -y --no-reboot-check --no-unreported-check || FAILED+=("firmware") ;;
    2) echo "Firmware is up to date." ;;
    *) echo "No supported firmware devices, or firmware check unavailable." ;;
  esac
fi

done_msg
